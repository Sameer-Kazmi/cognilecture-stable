OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_URL=http://localhost:11434/api/chat
OLLAMA_API_KEY=ollama

OLLAMA_MODEL=qwen2.5:3b
OLLAMA_COMPACT_MODEL=qwen2.5:0.5b-instruct

WHISPER_MODEL=base

# Prompt budget in characters (~4 chars per token). Keep well below 16384 tokens.
MAX_PROMPT_CHARS=36000
# Whisper CPU threads (defaults to the number of CPU cores)
# WHISPER_CPU_THREADS=8
# Maximum slides sampled for OCR
OCR_MAX_SLIDES=6
